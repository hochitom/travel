---
import Layout from '../layouts/Layout.astro';
import Karte from '../components/Karte.astro';
import ReiseKachel from '../components/ReiseKachel.astro';
import { einheiten, ladeBaum, pinsFuer, von } from '../lib/reisen';

const baum = await ladeBaum();
const pins = await pinsFuer(baum);
const neueste = einheiten(baum)
  .sort((a, b) => (von(b)?.getTime() ?? 0) - (von(a)?.getTime() ?? 0))
  .slice(0, 6);
---

<Layout>
  <div class="huelle">
    <section class="hero">
      <h1>Mein Reiselogbuch</h1>
      <p>Routen, Fotos und Randnotizen aus den Ländern, in denen ich unterwegs war. Eine Nadel auf der Karte führt zum Eintrag.</p>
      <p class="randnotiz">Tipp: Nadel antippen und Eintrag aufschlagen.</p>
    </section>

    <Karte pins={pins} hoehe="min(70vh, 38rem)" beschriftung="Weltkarte mit allen Reiseberichten" />

    {
      neueste.length > 0 ? (
        <section>
          <h2>Letzte Einträge</h2>
          <ul class="raster raster--betont">
            {neueste.map((k) => (
              <li>
                <ReiseKachel knoten={k} />
              </li>
            ))}
          </ul>
          <p><a href="/reisen/">Alle Reisen ansehen</a></p>
        </section>
      ) : (
        <p class="leer">Hier entstehen gerade die ersten Reiseberichte.</p>
      )
    }
  </div>
</Layout>
