---
/**
 * Logo von hochitom.travel: Kompassrose plus Schriftzug, optional mit Zusatzzeile.
 * Farben kommen aus den Variablen, der Dunkelmodus („Nachtwache“) wirkt automatisch.
 */
interface Props {
  groesse?: number;
  /** Kleinere Schrift und ohne Zusatzzeile, z. B. für den Header */
  kompakt?: boolean;
}
const { groesse = 56, kompakt = false } = Astro.props;
---

<span class:list={['logo', { 'logo--kompakt': kompakt }]}>
  <svg viewBox="0 0 64 64" width={groesse} height={groesse} aria-hidden="true">
    <circle cx="32" cy="32" r="22" fill="none" stroke="var(--akzent)" stroke-width="3" />
    <circle cx="32" cy="32" r="17" fill="none" stroke="var(--akzent)" stroke-width="1.5" />
    <path d="M32 14l4.5 14.5L51 32l-14.5 3.5L32 50l-4.5-14.5L13 32l14.5-3.5z" fill="var(--tinte)" />
    <path d="M32 14l2.6 15L32 32l-2.6-3z" fill="var(--akzent)" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">hochitom<span>.travel</span></span>
    {!kompakt && <span class="logo__zusatz">Logbuch der Reisen</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--tinte);
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .logo__name {
    font-family: var(--serif-kopf);
    font-size: 2.4rem;
    line-height: 1;
    white-space: nowrap;
  }
  .logo--kompakt .logo__name {
    font-size: 1.9rem;
  }
  .logo--kompakt {
    gap: 0.7rem;
  }
  .logo__name span {
    color: var(--akzent);
    font-style: italic;
  }
  .logo__zusatz {
    font-family: var(--serif);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--meer);
  }
</style>
