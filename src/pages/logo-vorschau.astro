---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const varianten = [
  { v: 'a', titel: 'A · Kompass und Schrift', text: 'Hauptlogo. Im Header ohne Zusatzzeile verwendbar.' },
  { v: 'b', titel: 'B · Gestapelt', text: 'Für quadratische und schmale Flächen, Avatare, Startseite.' },
  { v: 'c', titel: 'C · Route statt Kompass', text: 'Nur Schrift mit gestrichelter Route und Pin am Ziel.' },
] as const;
---

<Layout titel="Logo-Vorschau" beschreibung="Interne Vorschau der Logo-Varianten">
  <meta slot="head" name="robots" content="noindex" />
  <div class="huelle vorschau">
    <h1>Logo-Vorschau</h1>
    <p class="vorschau__hinweis">
      Entwurf, nicht verlinkt. Hell/Dunkel folgt der Systemeinstellung. Jede Variante steht einmal im
      Kopfbereich der Seite (so wie im Header), einmal groß.
    </p>

    {varianten.map((x) => (
      <section class="vorschau__block">
        <h2>{x.titel}</h2>
        <p>{x.text}</p>
        <div class="vorschau__kopf"><Logo variante={x.v} groesse={x.v === 'a' ? 44 : 56} /> <span class="vorschau__nav">Weltkarte &nbsp; Reisen</span></div>
        <div class="vorschau__gross"><Logo variante={x.v} groesse={x.v === 'a' ? 96 : 84} /></div>
      </section>
    ))}

    <section class="vorschau__block">
      <h2>D · Siegel</h2>
      <p>Für Fußzeile, „Über mich“ oder als Wasserzeichen.</p>
      <div class="vorschau__gross vorschau__reihe">
        <Logo variante="siegel" groesse={220} id="siegel-gross" />
        <Logo variante="siegel" groesse={96} id="siegel-klein" />
        <Logo variante="siegel" groesse={64} id="siegel-mini" />
      </div>
    </section>

    <section class="vorschau__block">
      <h2>E · Monogramm</h2>
      <p>Für Avatare und Social Media.</p>
      <div class="vorschau__gross vorschau__reihe">
        <Logo variante="monogramm" groesse={160} />
        <Logo variante="monogramm" groesse={72} />
        <Logo variante="monogramm" groesse={40} />
      </div>
    </section>

    <section class="vorschau__block">
      <h2>F · Favicon</h2>
      <p>Aktuell eingebunden ist die Tinte-Variante. Die Größen so, wie sie im Browser-Tab erscheinen.</p>
      <div class="vorschau__gross vorschau__reihe">
        <img src="/favicon.svg" width="128" height="128" alt="Favicon 128" />
        <img src="/favicon.svg" width="48" height="48" alt="Favicon 48" />
        <img src="/favicon.svg" width="32" height="32" alt="Favicon 32" />
        <img src="/favicon.svg" width="16" height="16" alt="Favicon 16" />
      </div>
    </section>
  </div>
</Layout>

<style>
  .vorschau { padding-block: 2rem 4rem; }
  .vorschau__hinweis { color: var(--tinte-leise); max-width: 60ch; }
  .vorschau__block { margin-top: 3rem; }
  .vorschau__block h2 { margin-bottom: 0.25rem; }
  .vorschau__block p { margin: 0 0 1rem; color: var(--tinte-leise); }
  .vorschau__kopf {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 1rem 2rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--linie);
    background: var(--papier);
  }
  .vorschau__nav { color: var(--tinte); }
  .vorschau__gross {
    display: flex; align-items: center; gap: 2rem; padding: 2rem;
    background: var(--papier-2); border: 1px solid var(--linie); margin-top: 1rem;
  }
  .vorschau__reihe { flex-wrap: wrap; }
</style>
