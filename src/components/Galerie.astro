---
/** Galerie: Bilder als galerie, jedes Bild öffnet sich in der Lightbox. Props siehe Bildgruppe.astro. */
import Bildgruppe from './Bildgruppe.astro';
import type { Bild } from './Bildgruppe.astro';
interface Props {
  bilder: Bild[];
}
const { bilder } = Astro.props;
---

<Bildgruppe art="galerie" bilder={bilder} />
