---
/**
 * Ein einzelner Berg als drehbare 3D-Skizze aus öffentlichen Daten (Höhen: Terrain Tiles, optional Wikidata).
 * Vor dem Klick steht nur ein Papierstreifen da, Code und Daten lädt der Browser erst danach
 * (src/scripts/modell.js, src/scripts/modelle/berg.js). Aussehen: src/styles/modell.css.
 *
 *   <Berg name="Festvågtind" lat={68.1783} lon={14.2248} hoehe={541} />
 *   <Berg name="Großglockner" wikidata="Q…" breite={6000} />
 *
 * In Markdown-Berichten dasselbe mit dem Marker `:::berg Name | Breite, Länge | 541 m` (siehe src/lib/berg-html.mjs).
 */
import { bergFigur } from '../lib/berg-html.mjs';

interface Props {
  /** Name des Bergs, steht auf dem Blatt und im Stempel */
  name: string;
  /** Breite in Grad, ungefähr reicht (der höchste Punkt im Umkreis von etwa 350 m wird gesucht) */
  lat?: number;
  /** Länge in Grad */
  lon?: number;
  /** Gipfelhöhe in m. Ohne Angabe aus Wikidata, sonst aus den Geländedaten */
  hoehe?: number;
  /** Wikidata-Kennung (Q mit Zahl) für Höhe und Lage */
  wikidata?: string;
  /** Kantenlänge des Ausschnitts in m, Standard 3000 */
  breite?: number;
  /** Faktor für die Höhe in der Darstellung, Standard 1,3 */
  ueberhoehung?: number;
  /** Eigener erster Satz der Bildunterschrift (Quellen werden immer angehängt) */
  unterschrift?: string;
}

const { unterschrift, ...rest } = Astro.props;
const sicher = unterschrift?.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<Fragment set:html={bergFigur({ ...rest, unterschrift: sicher })} />
