---
import Layout from '../layouts/Layout.astro';
---

<Layout titel="Impressum">
  <div class="text" style="padding-block:2rem">
    <h1>Impressum</h1>
    <div class="hinweis">
      <strong>Platzhalter.</strong> Bitte vor dem Livegang ausfüllen und prüfen. Für eine private
      Reise-Webseite in Österreich gelten die Angaben nach § 25 Mediengesetz (Offenlegung) und
      gegebenenfalls § 5 E-Commerce-Gesetz.
    </div>
    <h2>Medieninhaber und Herausgeber</h2>
    <p>
      Thomas Hochörtler<br />
      [Straße und Hausnummer]<br />
      [PLZ Ort], Österreich
    </p>
    <h2>Kontakt</h2>
    <p>E-Mail: [Adresse eintragen]</p>
    <h2>Grundlegende Richtung</h2>
    <p>Private Reiseberichte mit Fotos und Karten.</p>
  </div>
</Layout>
