---
/** Raster: Bilder als raster, jedes Bild öffnet sich in der Lightbox. Props siehe Bildgruppe.astro. */
import Bildgruppe from './Bildgruppe.astro';
import type { Bild } from './Bildgruppe.astro';
interface Props {
  bilder: Bild[];
}
const { bilder } = Astro.props;
---

<Bildgruppe art="raster" bilder={bilder} />
