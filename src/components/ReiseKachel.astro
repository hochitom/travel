---
import { Image } from 'astro:assets';
import { knotenUrl, kontinent, KONTINENTE, laender, zeitraum, type Knoten } from '../lib/reisen';

interface Props {
  knoten: Knoten;
}

const { knoten } = Astro.props;
const d = knoten.eintrag.data;
const kicker = knoten.eltern ? knoten.eltern.eintrag.data.titel : (KONTINENTE[kontinent(knoten) ?? ''] ?? '');
const land = laender(knoten).join(', ');
const meta = [zeitraum(knoten), land].filter(Boolean).join(' · ');
---

<article class="kachel">
  {
    d.titelbild ? (
      <Image
        class="kachel__bild"
        src={d.titelbild}
        alt={d.titelbildAlt ?? ''}
        width={640}
        height={427}
        loading="lazy"
      />
    ) : (
      <div class="kachel__platzhalter" aria-hidden="true">
        ✈
      </div>
    )
  }
  <div class="kachel__text">
    {kicker && <p class="kicker">{kicker}</p>}
    <h3><a href={knotenUrl(knoten)}>{d.titel}</a></h3>
    {meta && <p class="leise">{meta}</p>}
    {d.zusammenfassung && <p>{d.zusammenfassung}</p>}
  </div>
</article>
