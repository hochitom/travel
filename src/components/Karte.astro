---
import type { Pin, Station } from '../lib/reisen';

interface Props {
  pins?: Pin[];
  /** Linien mit nummerierten Stationen (Detailseiten) */
  routen?: Station[][];
  hoehe?: string;
  beschriftung?: string;
}

const { pins = [], routen = [], hoehe = '30rem', beschriftung = 'Karte' } = Astro.props;
const daten = JSON.stringify({ pins, routen });
---

<div class="seekarte">
  <div
    class="karte"
    data-karte
    data-daten={daten}
    style={`--karte-hoehe:${hoehe}`}
    role="region"
    aria-label={beschriftung}
  >
    <noscript><p class="leise">Die Karte braucht JavaScript.</p></noscript>
  </div>
  <svg class="kompass" viewBox="-80 -80 160 160" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <circle r="46"></circle>
      <circle r="36" stroke-dasharray="2 4"></circle>
      <path d="M0 -66 L10 -10 L66 0 L10 10 L0 66 L-10 10 L-66 0 L-10 -10 Z" style="fill: var(--papier-2)"></path>
      <path d="M0 -66 L6 -6 L0 0 Z M0 66 L-6 6 L0 0 Z" style="fill: var(--akzent); stroke: none"></path>
    </g>
    <text x="-5" y="-72" font-size="14" fill="currentColor" style="font-family: var(--serif-kopf)">N</text>
  </svg>
</div>

<style>
  /* Rahmen wie bei einer Seekarte: Papier, doppelte Linie, Kompassrose in der Ecke */
  .seekarte {
    position: relative;
    padding: 0.4rem;
    background: var(--papier-2);
    border: 1px solid var(--tinte);
    box-shadow: 3px 4px 0 var(--schatten);
  }

  .karte {
    height: var(--karte-hoehe);
    min-height: 16rem;
    border: 1px solid var(--tinte);
    background: var(--papier-2);
    overflow: hidden;
  }

  .karte :global(.leaflet-container) {
    height: 100%;
  }

  /* Die Kacheln bekommen den Ton von altem Kartenpapier */
  .karte :global(.leaflet-tile-pane) {
    filter: sepia(0.5) saturate(0.8) hue-rotate(-10deg) contrast(0.95);
  }

  .kompass {
    position: absolute;
    z-index: 500;
    left: 0.9rem;
    bottom: 0.9rem;
    width: clamp(3.5rem, 9vw, 5.5rem);
    height: auto;
    color: var(--tinte);
    opacity: 0.85;
    pointer-events: none;
  }

  @media (prefers-color-scheme: dark) {
    .karte :global(.leaflet-tile-pane) {
      /* Die Standardkacheln sind hell: für Nachtwache umkehren und abdunkeln */
      filter: invert(1) hue-rotate(180deg) sepia(0.25) saturate(0.6) brightness(0.85) contrast(0.9);
    }
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type P = {
    titel: string;
    url: string;
    lat: number;
    lng: number;
    zeit?: string;
    ort?: string;
    bild?: string;
  };
  type R = { name: string; lat: number; lng: number; notiz?: string; url: string; eintrag: string; bild?: string };

  // Standardkacheln von OpenStreetMap: kein API-Key nötig, Nutzungsrichtlinie beachten
  // (https://operations.osmfoundation.org/policies/tiles/). Hell/Dunkel regelt der CSS-Filter oben.
  const KACHELN = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';
  const QUELLE =
    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende';

  // Infokarte: quadratisches Titelbild (falls vorhanden), Titel, Zusatzzeile, Link zum Eintrag
  function popup(titel: string, zusatz: string | undefined, url: string, bild?: string, eintrag?: string): HTMLElement {
    const box = document.createElement('div');
    box.className = 'popup';
    if (bild) {
      const img = document.createElement('img');
      img.src = bild;
      img.alt = '';
      img.width = 320;
      img.height = 320;
      img.loading = 'lazy';
      box.append(img);
    }
    const t = document.createElement('strong');
    t.textContent = titel;
    box.append(t);
    if (zusatz) {
      const small = document.createElement('small');
      small.textContent = zusatz;
      box.append(small);
    }
    const link = document.createElement('a');
    link.href = url;
    link.textContent = eintrag ? `Zum Eintrag „${eintrag}“` : 'Eintrag aufschlagen';
    box.append(link);
    return box;
  }

  function starte(el: HTMLElement) {
    if (el.dataset.bereit) return;
    el.dataset.bereit = '1';

    const { pins = [], routen = [] } = JSON.parse(el.dataset.daten ?? '{}') as {
      pins: P[];
      routen: R[][];
    };

    const karte = L.map(el, { scrollWheelZoom: false, worldCopyJump: true, minZoom: 2 });
    karte.on('focus', () => karte.scrollWheelZoom.enable());
    karte.on('blur', () => karte.scrollWheelZoom.disable());

    const dunkel = window.matchMedia('(prefers-color-scheme: dark)');
    L.tileLayer(KACHELN, { attribution: QUELLE, maxZoom: 18 }).addTo(karte);

    const punkte: L.LatLngTuple[] = [];

    for (const p of pins) {
      const icon = L.divIcon({
        className: 'pin',
        html: '<span></span>',
        iconSize: [44, 44],
        iconAnchor: [22, 22],
        popupAnchor: [0, -14],
      });
      L.marker([p.lat, p.lng], { icon, title: p.titel, keyboard: true })
        .bindPopup(popup(p.titel, [p.ort, p.zeit].filter(Boolean).join(', '), p.url, p.bild), { maxWidth: 220 })
        .addTo(karte);
      punkte.push([p.lat, p.lng]);
    }

    for (const route of routen) {
      const linie = route.map((s) => [s.lat, s.lng] as L.LatLngTuple);
      L.polyline(linie, { color: dunkel.matches ? '#86bccb' : '#2f5d6b', weight: 3, opacity: 0.85, dashArray: '3 9', lineCap: 'round' }).addTo(karte);
      route.forEach((s, i) => {
        const icon = L.divIcon({
          className: '',
          html: `<div class="route-nummer">${i + 1}</div>`,
          iconSize: [24, 24],
          iconAnchor: [12, 12],
        });
        L.marker([s.lat, s.lng], { icon, title: s.name })
          .bindPopup(popup(s.name, s.notiz, s.url, s.bild, s.eintrag), { maxWidth: 220 })
          .addTo(karte);
        punkte.push([s.lat, s.lng]);
      });
    }

    if (punkte.length > 1) {
      karte.fitBounds(L.latLngBounds(punkte), { padding: [40, 40], maxZoom: 13 });
    } else if (punkte.length === 1) {
      karte.setView(punkte[0], 8);
    } else {
      karte.setView([25, 10], 2);
    }
  }

  const beobachter = new IntersectionObserver(
    (eintraege) => {
      for (const e of eintraege) {
        if (e.isIntersecting) {
          starte(e.target as HTMLElement);
          beobachter.unobserve(e.target);
        }
      }
    },
    { rootMargin: '200px' },
  );

  document.querySelectorAll<HTMLElement>('[data-karte]').forEach((el) => beobachter.observe(el));
</script>
